<%- include('partials/header') %>
    <main class="page-shell" id="main-content">
        <header class="page-heading">
            <p class="page-kicker">Choose your cause</p>
            <h1><%= title %></h1>
            <p class="page-intro">Explore the causes where your time, care, and skills can make a difference.</p>
        </header>
        <ul class="category-grid" aria-label="Service categories">
            
            <% categories.forEach(category => { %>
                <li class="category-card">
                    <strong class="category-card-name"><%= category.category_name %></strong>
                </li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>
