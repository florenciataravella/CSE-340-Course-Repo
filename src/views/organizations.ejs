<%- include('partials/header') %>
    <main class="page-shell" id="main-content">
        <header class="page-heading">
            <p class="page-kicker">Working together</p>
            <h1><%= title %></h1>
            <p class="page-intro">Meet the partner organizations connecting people with meaningful service in their communities.</p>
        </header>
        <ul class="organization-grid" aria-label="Partner organizations">
            
                <% organizations.forEach(function(organization) { %>
                    <li class="organization-card">
                    <img src="/images/<%= organization.logo_filename %>" class="organization-card-logo">
                    <alt = "<%= organization.name %> logo"
                    <strong class="organization-card-name"><%= organization.name %><strong>:
                    <%=organization.contact_email%>     
                    </li>
                    <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>