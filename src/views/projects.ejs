<%- include('partials/header') %>
    <main class="page-shell" id="main-content">
        <header class="page-heading">
            <p class="page-kicker">Get involved</p>
            <h1><%= title %></h1>
            <p class="page-intro">Small acts of service can make a lasting difference. Find a way to show up for your neighbors.</p>
        </header>
        <section aria-labelledby="upcoming-projects">
            <h2 id="upcoming-projects">Upcoming service projects</h2>
            <ul class="project-grid">
                <li class="project-card">
                    <span class="project-number" aria-hidden="true">01</span>
                    <h3>Park Cleanup</h3>
                    <p>Join us to clean up local parks and make them beautiful.</p>
                </li>
                <li class="project-card">
                    <span class="project-number" aria-hidden="true">02</span>
                    <h3>Food Drive</h3>
                    <p>Help collect and distribute food to those in need.</p>
                </li>
                <li class="project-card">
                    <span class="project-number" aria-hidden="true">03</span>
                    <h3>Community Tutoring</h3>
                    <p>Volunteer to tutor students in a range of subjects.</p>
                </li>
            </ul>
        </section>
    </main>
<%- include('partials/footer') %>